;; Two dependencies, both of them things this workspace already had and would
;; otherwise have grown a second copy of (the lesson of ADR-2607254100, where
;; AWS SigV4 turned out to exist six times):
;;
;;   proto            — the protobuf wire codec. Storj signs serialized
;;                      messages, so re-encoding has to be byte-exact,
;;                      including fields this build does not recognise.
;;   io-multiformats  — base58, base32 and SHA-256, already portable across
;;                      the runtimes this library targets.
;;
;; No Storj SDK, no TLS stack, no protobuf runtime: those would each pin this
;; to one runtime, which is the whole thing being avoided.
{:paths ["src"]
 :deps {io.github.kotoba-lang/proto
        {:git/sha "0eba39ede385ddf6894d5a099515064cf919aee8"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts — `clojure -A:cljs -Spath` resolves the git
  ;; deps for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}

  ;; `scripts/` is not on :paths — nothing in the library loads it, and a
  ;; consumer pulling this in as a git dep should not get a `mint-identity`
  ;; namespace they did not ask for.
  :mint {:extra-paths ["scripts"]
         :main-opts ["-m" "mint-identity"]}

  :tls-peer {:extra-paths ["scripts"]
             :main-opts ["-m" "tls-peer"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
